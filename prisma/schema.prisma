datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  material         String?
  featured         Boolean  @default(false)
  available        Boolean  @default(true)
  image            String?
  gallery          String[] @default([])
  specifications   Json?    @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Enquiry {
  id           String        @id @default(uuid())
  name         String
  phone        String
  email        String?
  city         String?
  companyName  String?
  businessType String?
  enquiryType  String?
  product      String?
  quantity     String?
  message      String
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model BusinessSettings {
  id               String   @id @default("global")
  name             String   @default("Hari Har Industries")
  brand            String   @default("Mehak")
  tagline          String   @default("Complete Bathroom Solution")
  description      String   @default("Hari Har Industries manufactures and supplies a comprehensive range of sanitary hardware under the Mehak brand. Built around precision engineering and high-grade raw materials, Mehak caters to retailers, dealers, distributors, commercial contractors, and homeowners across India seeking durable, elegant, and efficient bathroom fittings.")
  phonePrimary     String   @default("8307721917")
  phoneSecondary   String?  @default("9354222883")
  phoneTertiary    String?  @default("9518405643")
  whatsapp         String   @default("8307721917")
  email            String   @default("piyushverma282005@gmail.com")
  emailSecondary   String?  
  address          String   @default("Industrial Area, Sector 5")
  city             String   @default("Faridabad")
  state            String   @default("Haryana")
  pincode          String   @default("121006")
  country          String   @default("India")
  googleMapsUrl    String?  @default("https://maps.google.com")
  mapEmbedUrl      String?  
  instagramUrl     String?  
  facebookUrl      String?  
  youtubeUrl       String?  
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}
